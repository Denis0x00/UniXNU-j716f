 	sched_edge_tg_preferred_cluster_change(tg, tg_bucket_preferred_cluster, options);
 }
 
+/*
+ * Without a performance controller (native-smp-type-clusters.patch): every thread group that exists when all
+ * clusters are up gets the scheduler's default per-bucket preferences the way CLPC sets them, with its
+ * runnable threads moved to their new preferred cluster. Called once, from sched_edge_cpu_init_completed().
+ */
+void thread_group_set_default_preferred_clusters(uint32_t *tg_bucket_preferred_cluster);
+void
+thread_group_set_default_preferred_clusters(uint32_t *tg_bucket_preferred_cluster)
+{
+	struct thread_group *tg;
+	lck_mtx_lock(&tg_lock);
+	qe_foreach_element(tg, &tg_queue, tg_queue_chain) {
+		sched_edge_tg_preferred_cluster_change(tg, tg_bucket_preferred_cluster, SCHED_PERFCONTROL_PREFERRED_CLUSTER_MIGRATE_RUNNABLE);
+	}
+	lck_mtx_unlock(&tg_lock);
+}
