+#if CONFIG_SCHED_EDGE
+/*
+ * Preferences without a performance controller. Every bucket group starts out preferring the boot cluster
+ * (pset0), and only CLPC changes that. Where the boot cluster is an E cluster, the default edges (no E->P
+ * migration or steal) would then keep every thread off the P cores. Once all clusters are up
+ * (sched_edge_cpu_init_completed), the fixed-priority bucket and the timeshare buckets above utility prefer
+ * the first P cluster, utility and background the first E cluster: the thread groups that exist then get
+ * these preferences the way CLPC sets them (thread_group_set_default_preferred_clusters), and later ones
+ * start out with them.
+ */
+static uint32_t sched_edge_default_preferred_cluster[TH_BUCKET_SCHED_MAX];
+static bool sched_edge_default_preferences_ready;
+
+/*
+ * Fixed priority, UI and user-initiated threads that prefer the P cluster neither migrate nor get stolen to
+ * the E cluster. Cortex-A55 cores run at a fraction of Cortex-A77 speed, so such a thread waits for (or
+ * preempts lower work on) a P core instead.
+ */
+static bool
+sched_edge_ui_bucket_stays_on_p(cluster_type_t from, cluster_type_t to, sched_bucket_t bucket)
+{
+	return from == CLUSTER_TYPE_P && to == CLUSTER_TYPE_E && bucket < TH_BUCKET_SHARE_DF;
+}
+#endif /* CONFIG_SCHED_EDGE */
