+
+	/* The preferences without a performance controller (sched_edge_clutch_bucket_group_preferred_cluster) */
+	int e_cluster = -1, p_cluster = -1;
+	for (int cluster_id = 0; cluster_id < sched_edge_max_clusters; cluster_id++) {
+		processor_set_t pset = pset_array[cluster_id];
+		if (pset == PROCESSOR_SET_NULL) {
+			continue;
+		}
+		if (pset->pset_type == CLUSTER_TYPE_E && e_cluster < 0) {
+			e_cluster = cluster_id;
+		} else if (pset->pset_type == CLUSTER_TYPE_P && p_cluster < 0) {
+			p_cluster = cluster_id;
+		}
+	}
+	if (e_cluster < 0 || p_cluster < 0) {
+		/* One cluster type only: every bucket keeps the boot cluster, as before */
+		return;
+	}
+	for (int bucket = 0; bucket < TH_BUCKET_SCHED_MAX; bucket++) {
+		sched_edge_default_preferred_cluster[bucket] =
+		    (bucket == TH_BUCKET_SHARE_UT || bucket == TH_BUCKET_SHARE_BG) ? (uint32_t)e_cluster : (uint32_t)p_cluster;
+	}
