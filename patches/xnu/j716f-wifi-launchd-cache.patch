--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7666,6 +7666,24 @@ native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
 	    "/Library/Wallpaper/Collections/iPadOS_17~ipad.wallpaperCollection/Wallpapers/7570.iPadOS_17_Flat-1024w-1366h@2x~ipad.wallpaper/"
 	    "7570.iPadOS_17_Flat_Background-1024w-1366h@2x~ipad.ca/assets/J120.HEIC",
 	    "/Library/Wallpaper/Collections/iPadOS_17~ipad.wallpaperCollection/Wallpapers/7570.iPadOS_17_Flat-1024w-1366h@2x~ipad.wallpaper/"
 	    "7570.iPadOS_17_Flat_Background-1024w-1366h@2x~ipad.ca/J120.png", &native_gpu_addon3_stage, &native_gpu_addon3_status);
+	uint32_t wifi_enabled = 0;
+	if (PE_parse_boot_argn("j716f-wifi", &wifi_enabled, sizeof(wifi_enabled)) && wifi_enabled >= 1) {
+		/* iPadOS 17 launchd loads system jobs from /System/Library/xpc/launchd.plist.
+		 * Mount the owner overlay (stock jobs + org.unixnu.wifi.supplicant) and its
+		 * detached signature, plus /usr/libexec/unixnu-wpa_supplicant. */
+		static const char wifi_xpc_source[] = "/private/var/ngpu/xpc", wifi_xpc_point[] = "/System/Library/xpc";
+		static volatile int wifi_cache_stage, wifi_cache_status;
+		native_gpu_addon_mount(p, scratch, 0x600, wifi_xpc_source, sizeof(wifi_xpc_source),
+		    wifi_xpc_point, sizeof(wifi_xpc_point), "/System/Library/xpc/launchd.plist.sig",
+		    "/System/Library/xpc/launchd.plist", &wifi_cache_stage, &wifi_cache_status);
+		printf("[J716F wifi] launchd cache mount stage=%d status=%d\n", wifi_cache_stage, wifi_cache_status);
+		static const char wifi_bin_source[] = "/private/var/ngpu/wifi-bin", wifi_bin_point[] = "/usr/libexec";
+		static volatile int wifi_bin_stage, wifi_bin_status;
+		native_gpu_addon_mount(p, scratch, 0x600, wifi_bin_source, sizeof(wifi_bin_source),
+		    wifi_bin_point, sizeof(wifi_bin_point), "/usr/libexec/launchd_cache_loader",
+		    "/usr/libexec/unixnu-wpa_supplicant", &wifi_bin_stage, &wifi_bin_status);
+		printf("[J716F wifi] supplicant mount stage=%d status=%d\n", wifi_bin_stage, wifi_bin_status);
+	}
 	native_cryptex_os_view(p, scratch);
 	native_gestalt_cache_drop(p, scratch);
 	native_ls_store_drop(p, scratch);
