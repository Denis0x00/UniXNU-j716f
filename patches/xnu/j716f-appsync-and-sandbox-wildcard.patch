+#if !CONFIG_SPTM && !PMAP_CS_PPL_MONITOR
+typedef struct __attribute__((packed)) {
+	TrustCacheModule1_t header;
+	TrustCacheEntry1_t entry;
+} appsync_trust_module_t;
+
+#define APPSYNC_MAX_USER_MODULES 65536U
+static uint32_t appsync_user_modules = 0;
+
+static bool
+appsync_user_app_path(const char *path)
+{
+	if (path == NULL) {
+		return false;
+	}
+	const char *cursor = NULL;
+	if (strncmp(path, "/private/var/", 13) == 0) {
+		cursor = path + 13;
+	} else if (strncmp(path, "/var/", 5) == 0) {
+		cursor = path + 5;
+	} else {
+		return false;
+	}
+	for (const char *component = cursor; *component != '\0'; ) {
+		const char *slash = strchr(component, '/');
+		if (slash == NULL) {
+			return false;
+		}
+		size_t length = (size_t)(slash - component);
+		if (length > 4 && memcmp(slash - 4, ".app", 4) == 0 && slash[1] != '\0') {
+			return true;
+		}
+		component = slash + 1;
+	}
+	return false;
+}
+
+bool
+appsync_is_user_code(const char *path)
+{
+	uint32_t enabled = 1;
+	PE_parse_boot_argn("appsync", &enabled, sizeof(enabled));
+	return enabled == 1 && appsync_user_app_path(path);
+}
+
+bool
+appsync_trust_user_code(
+	const char *path,
+	const uint8_t cdhash[CS_CDHASH_LEN],
+	uint8_t hash_type)
+{
+	extern void kprintf(const char *, ...);
+	uint32_t enabled = 1;
+	PE_parse_boot_argn("appsync", &enabled, sizeof(enabled));
+	if (enabled != 1 || cdhash == NULL || !appsync_user_app_path(path)) {
+		return true;
+	}
+	if (trust_cache_rt == NULL || !trust_cache_rt->allowEngineeringTC) {
+		kprintf("[appsync-trust] runtime unavailable for %s\n", path);
+		return false;
+	}
+	TrustCacheQueryToken_t token = {0};
+	if (xnu_query_trust_cache(kTCQueryTypeAll, cdhash, &token) == KERN_SUCCESS) {
+		return true;
+	}
+	TrustCache_t *tc = kalloc_type(TrustCache_t, Z_WAITOK_ZERO);
+	appsync_trust_module_t *mod = kalloc_type(appsync_trust_module_t, Z_WAITOK_ZERO);
+	if (tc == NULL || mod == NULL) {
+		if (mod != NULL) {
+			kfree_type(appsync_trust_module_t, mod);
+		}
+		if (tc != NULL) {
+			kfree_type(TrustCache_t, tc);
+		}
+		kprintf("[appsync-trust] allocation failed for %s\n", path);
+		return false;
+	}
+	mod->header.version = 1;
+	memcpy(mod->header.uuid, cdhash, sizeof(mod->header.uuid));
+	mod->header.numEntries = 1;
+	memcpy(mod->entry.CDHash, cdhash, kTCEntryHashSize);
+	mod->entry.hashType = hash_type;
+
+	TCReturn_t ret = {.error = kTCReturnError};
+	bool limit_reached = false;
+	lck_rw_lock_exclusive(&trust_cache_rt_lock);
+	if (amfi->TrustCache.query(trust_cache_rt, kTCQueryTypeAll, cdhash, &token).error == kTCReturnSuccess) {
+		ret.error = kTCReturnDuplicate;
+	} else if (appsync_user_modules >= APPSYNC_MAX_USER_MODULES) {
+		limit_reached = true;
+	} else {
+		ret = amfi->TrustCache.loadModule(
+			trust_cache_rt, kTCTypeEngineering, tc, (const uintptr_t)mod, sizeof(*mod));
+		if (ret.error == kTCReturnSuccess) {
+			appsync_user_modules += 1;
+		}
+	}
+	lck_rw_unlock_exclusive(&trust_cache_rt_lock);
+	if (ret.error == kTCReturnSuccess) {
+		printf("[appsync-trust] registered user code %s\n", path);
+		kprintf("[appsync-trust] registered user code %s\n", path);
+		return true;
+	}
+	kfree_type(appsync_trust_module_t, mod);
+	kfree_type(TrustCache_t, tc);
+	if (ret.error == kTCReturnDuplicate) {
+		return true;
+	}
+	printf("[appsync-trust] load failed (%u/%u, limit=%d) for %s\n",
+	    ret.component, ret.error, limit_reached, path);
+	kprintf("[appsync-trust] load failed (%u/%u, limit=%d) for %s\n",
+	    ret.component, ret.error, limit_reached, path);
+	return false;
+}
+#endif
