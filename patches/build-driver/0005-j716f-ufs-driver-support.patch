+        ufs_text = ufs_text.replace(s2, 'return v;}\n#if defined(NATIVE_VERIFIED_BLOCK) && NATIVE_VERIFIED_BLOCK\nvolatile uint32_t native_ufs_integrity_failures = 0;')
