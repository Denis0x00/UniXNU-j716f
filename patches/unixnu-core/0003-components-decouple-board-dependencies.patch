From: Denis0x00 <148704309+Denis0x00@users.noreply.github.com>
Subject: [PATCH 3/4] components: decouple Adreno740 and ShengHidInput from SM8550/sheng board components

Allow non-SM8550 boards (such as SM8250 / TB-J716F) that provide their own GPU
platform kit and touch controller driver to resolve Adreno740 and ShengHidInput
from components.toml without pulling in Sm8550Platform or ShengNovatekTouch.
Board-level platform and touch requirements remain documented under
board_dependencies.
---
diff --git a/components.toml b/components.toml
index 585edba..987d4d0 100644
--- a/components.toml
+++ b/components.toml
@@ -87,9 +87,9 @@ revision = "2962e289c9690aeb668072c170679e6fb28bf8de"
 path = "drivers/Adreno740"
 hardware = ["Adreno 740", "SM8550"]
 os_abi = ["ipados-17.7.11-21H461"]
-board_dependencies = ["ZAP firmware", "GPU power policy", "reserved memory"]
+board_dependencies = ["SoC GPU platform operations (e.g. Sm8550Platform)", "ZAP firmware", "GPU power policy", "reserved memory"]
 verified_devices = ["sheng"]
-dependencies = ["Sm8550Platform", "AdrenoPM4", "AdrenoFirmware", "ArmSmmu4K"]
+dependencies = ["AdrenoPM4", "AdrenoFirmware", "ArmSmmu4K"]
 source_files = ["NativeAdrenoService.cpp"]
 runtime_identifiers = ["NativeAdreno", "NativeAdrenoService.cpp", "org.blu-sharky.NativeAdreno", "NativeAdrenoGpuService", "NativeAdrenoSmmuService", "NativeAdrenoGmuService"]
 build_stage = "kernel"
@@ -154,7 +154,7 @@ hardware = ["sheng touch event source"]
 os_abi = ["ipados-17.7.11-21H461"]
 board_dependencies = ["touch coordinates and event globals"]
 verified_devices = ["sheng"]
-dependencies = ["ShengNovatekTouch"]
+dependencies = []
 source_files = ["NativeHidInput.cpp"]
 runtime_identifiers = ["NativeHidInput", "NativeHidInput.cpp"]
 build_stage = "kernel"
