 use super::command_buffer::CommandBuffer;
+/// Where the compositor's encoder takes its CPU time, in nanoseconds by step and by call kind: the draw's steps (the bind state and variant, the
+/// command it builds, the heaps and descriptors, the record), the pass's close (its end, its shadow copies, its bookkeeping), and the commit's
+/// (state collection, host-step preparation, planning, the queue submit). Read by the device's telemetry (`phase_timings`, the D/C/B rows);
+/// diagnostic only, and off the command's own result.
+pub(crate) mod phases {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    use std::time::Instant;
+
+    pub(crate) const DRAW_SETTLE: usize = 0;
+    pub(crate) const DRAW_COMMANDS: usize = 1;
+    pub(crate) const DRAW_HEAPS: usize = 2;
+    pub(crate) const DRAW_RECORD: usize = 3;
+    pub(crate) const CLOSE_END_PASS: usize = 4;
+    pub(crate) const CLOSE_SHADOWS: usize = 5;
+    pub(crate) const CLOSE_BOOKKEEPING: usize = 6;
+    pub(crate) const COMMIT_STATE: usize = 7;
+    pub(crate) const COMMIT_PREPARE: usize = 8;
+    pub(crate) const COMMIT_PLAN: usize = 9;
+    pub(crate) const COMMIT_SUBMIT: usize = 10;
+    /// The steps, in nanoseconds.
+    pub(crate) static NS: [AtomicU64; 11] = [const { AtomicU64::new(0) }; 11];
+    /// The draws, closes and commits counted.
+    pub(crate) static COUNT: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+    pub(crate) fn add(step: usize, from: Instant, to: Instant) {
+        NS[step].fetch_add(to.saturating_duration_since(from).as_nanos() as u64, Relaxed);
+    }
+
+    pub(crate) fn counted(kind: usize) {
+        COUNT[kind].fetch_add(1, Relaxed);
+    }
+}
+
+/// [`phases`]' answer: the eleven steps' nanoseconds, then the draws, closes and commits counted.
+pub fn phase_timings() -> [u64; 14] {
+    use std::sync::atomic::Ordering::Relaxed;
+    let mut out = [0u64; 14];
+    for (i, step) in phases::NS.iter().enumerate() {
+        out[i] = step.load(Relaxed);
+    }
+    for (i, count) in phases::COUNT.iter().enumerate() {
+        out[11 + i] = count.load(Relaxed);
+    }
+    out
+}
