+/// The compositor's scanout copies, counted for the device's telemetry (`copy_census`): the copies out of a texture, the path each took
+/// (one buffer-image copy, one buffer copy per texel row, or a scratch buffer), and the regions and commands they recorded. Diagnostic only;
+/// nothing here changes a copy. A 1800 x 2880 frame into a 7200-byte scanout is 2880 rows, about 5.5 ms of CPU and 4.3 ms of GPU a frame at
+/// 2026-10-25, against one buffer-image copy of one command.
+pub(crate) mod copy_census {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    /// Copies out of a texture, and the path each took.
+    pub(crate) static TEXTURE_TO_BUFFER: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static IMAGE_PATH: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static ROWS_PATH: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static STAGING_PATH: AtomicU64 = AtomicU64::new(0);
+    /// The buffer copies and buffer-image regions those paths recorded, and the last rows copy's row count.
+    pub(crate) static ROW_REGIONS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static IMAGE_REGIONS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static LAST_ROWS: AtomicU64 = AtomicU64::new(0);
+
+    pub(crate) fn counted(counter: &AtomicU64) {
+        counter.fetch_add(1, Relaxed);
+    }
+
+    pub(crate) fn added(counter: &AtomicU64, by: u64) {
+        counter.fetch_add(by, Relaxed);
+    }
+}
+
+/// [`copy_census`]'s counters: copies out of a texture, those of each path, their regions, and the last rows copy's row count.
+pub fn copy_census() -> [u64; 7] {
+    use std::sync::atomic::Ordering::Relaxed;
+    [
+        copy_census::TEXTURE_TO_BUFFER.load(Relaxed),
+        copy_census::IMAGE_PATH.load(Relaxed),
+        copy_census::ROWS_PATH.load(Relaxed),
+        copy_census::STAGING_PATH.load(Relaxed),
+        copy_census::ROW_REGIONS.load(Relaxed),
+        copy_census::IMAGE_REGIONS.load(Relaxed),
+        copy_census::LAST_ROWS.load(Relaxed),
+    ]
+}
