+/// The pools of completed commands, kept for the next command of the same sizes: `write_each`
+/// resets one instead of creating a pool, whose descriptor memory the driver allocates and maps
+/// each time (Turnip on NativeAdreno: a buffer object, two kernel calls; a mipmap chain makes one
+/// pool per command, several per frame of a compositor's blurs). At most [`KEPT_PER_SIZE`] of a
+/// size are kept; the others are destroyed as before.
+type PoolKey = (u64, u32, u32, u32, u32); // device, sets, sampled images, storage images, buffers
+static KEPT_POOLS: std::sync::Mutex<Vec<(PoolKey, vk::DescriptorPool)>> = std::sync::Mutex::new(Vec::new());
+const KEPT_PER_SIZE: usize = 16;
+
 impl Drop for OwnedSets {
     fn drop(&mut self) {
         // Once the process is exiting, the pool is left to its end (`exit_guard`).
         let Some(_busy) = exit_guard::enter() else {
             return;
         };
-        // SAFETY: no pending command uses the sets (a command buffer retains them until it
-        // completes); the sets are freed with their pool.
+        // No pending command uses the sets (a command buffer retains them until it completes):
+        // the pool is kept for reuse where there is room, else destroyed with its sets.
+        {
+            let mut kept = lock(&KEPT_POOLS);
+            if kept.iter().filter(|(key, _)| *key == self.key).count() < KEPT_PER_SIZE {
+                kept.push((self.key, self.pool));
+                return;
+            }
+        }
+        // SAFETY: as above; the sets are freed with their pool.
         unsafe { release::object(self.device.shared().vk(), self.pool) };
     }
 }
