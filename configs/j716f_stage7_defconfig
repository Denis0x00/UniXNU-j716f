# TB-J716F / SM8250 / arm64 / iPadOS 17.7.11 (21H461)
# Stage 7 host-verified bring-up: read-only SHNGROOT OS + SystemOS union mount
# + RAM-backed 16 GiB APFS Data volume (NativeRamBlock) -> /sbin/launchd.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_BOOT_PROGRESS is not set
# CONFIG_XNU_SHENG_PMGR is not set

# Source-built storage + NativeRamBlock embedded in libJ716fStorageBringup.a.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="E146D844-B009-41DE-900A-8E49DCFEBA81"

# Use the device-tree panic region rather than BCM2837 fixed address.
CONFIG_XNU_DT_PANIC_REGION=y

# Consolidated SM8250 + board read-only UFS/SHNGROOT + NativeRamBlock archive.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/j716f-storage-active/libJ716fStorageBringup.a"
