# Native architectural timer + ArmCpu/ArmDTPlatform source integration candidate.
# Use scripts/prepare-native-platform.py or build-j716f-source.py --native-arch-timer.
# Upstream requires the actual ArmCpu interrupt provider with native timer entry.
# Compilation/linkage is separate from driver matching and real timer IRQ proof.
# No IPSW, prelink, device ADT, userdata or board MMIO inputs are used.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_BOOT_PROGRESS=n
